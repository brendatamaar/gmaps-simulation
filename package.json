{
  "name": "gmaps-simulation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --import ./node_modules/tsx/dist/esm/index.cjs src/index.ts",
    "route": "node --import ./node_modules/tsx/dist/esm/index.cjs src/route.ts",
    "build:wasm": "asc assembly/index.ts --target release --outFile build/release.wasm --optimize --runtime stub",
    "validate:as": "node --import ./node_modules/tsx/dist/esm/index.cjs src/validate-as.ts",
    "export:graph": "node --import ./node_modules/tsx/dist/esm/index.cjs src/export-graph.ts",
    "export:ch": "node --import ./node_modules/tsx/dist/esm/index.cjs src/export-ch.ts",
    "export:alt": "node --import ./node_modules/tsx/dist/esm/index.cjs src/export-alt.ts",
    "test:ch": "node --import ./node_modules/tsx/dist/esm/index.cjs src/test-ch.ts",
    "ch:city": "node --import ./node_modules/tsx/dist/esm/index.cjs src/bench-ch.ts",
    "gen:traffic": "node --import ./node_modules/tsx/dist/esm/index.cjs src/gen-traffic.ts",
    "verify:traffic-data": "node --import ./node_modules/tsx/dist/esm/index.cjs src/verify-traffic-data.ts",
    "inspect:traffic": "node --import ./node_modules/tsx/dist/esm/index.cjs src/inspect-traffic.ts",
    "verify:traffic-routing": "node --import ./node_modules/tsx/dist/esm/index.cjs src/verify-traffic-routing.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "assemblyscript": "^0.28.19",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "osm-pbf-parser": "^2.3.0"
  }
}
